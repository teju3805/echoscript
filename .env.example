# ---- Required ----------------------------------------------------------
# Any Postgres. Neon's *pooled* connection string is what you want.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gnani Prisma v2.5 key, Speech-to-Text scope. Sent as the X-API-Key-ID header.
GNANI_API_KEY=

# Injected automatically by Vercel when a Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=

# ---- Summariser (pick one; without any of these you get a labelled
#      extractive fallback rather than a failure) --------------------------
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini          # pin a provider instead of auto-selecting
# GEMINI_MODEL=gemini-2.5-flash

# ---- Optional ----------------------------------------------------------
NEXT_PUBLIC_REPO_URL=https://github.com/YOUR-GITHUB-USERNAME/echoscript
# CRON_SECRET=                 # locks /api/cron/tick
# GNANI_BASE_URL=              # override for the test mock

# Local development only. Whitelists a plain-http blob host so the test
# harness works. NEVER set this in production — production accepts only
# https://*.public.blob.vercel-storage.com
# BLOB_PUBLIC_HOST=localhost
